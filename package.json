{
  "name": "cluster-ui",
  "version": "0.1.0",
  "description": "Effect Cluster operations dashboard",
  "type": "module",
  "bin": {
    "cluster-ui": "./bin/cluster-ui.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server/dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev:server": "node scripts/dev-server.mjs",
    "dev:web": "vite",
    "build:server": "node scripts/build-server.mjs",
    "build": "pnpm build:server && vite build",
    "start": "node server/dist/main.cjs",
    "seed": "node server/src/seed.ts",
    "typecheck": "bash -c 'out=$(tsc --noEmit --pretty false 2>&1); filtered=$(echo \"$out\" | grep -E \"^(server|web|vite\\\\.config|index\\\\.html)\"); if [ -n \"$filtered\" ]; then echo \"$filtered\"; exit 1; fi'",
    "e2e": "pnpm build && node server/scripts/e2e.ts",
    "smoke": "node web/smoke.mjs",
    "test:cli": "node scripts/test-cli.mjs",
    "demo-runner": "node server/scripts/demo-runner.ts",
    "dev:redis": "bash scripts/dev-redis.sh",
    "seed:redis": "node scripts/demo-redis.mjs",
    "redis:cli": "redis-cli -p 6399",
    "dev": "node scripts/dev-all.mjs",
    "e2e:browser": "node scripts/browser-e2e.mjs",
    "e2e:bdd": "pnpm build && bddgen && playwright test",
    "e2e:bdd:generate": "bddgen",
    "try:redis": "bash scripts/try-redis.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.41",
    "@ai-sdk/openai": "4.0.46",
    "@ai-sdk/react": "4.0.80",
    "@base-ui/react": "1.7.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@parcel/watcher": "2.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@xyflow/react": "12.11.3",
    "ai": "7.0.77",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cnfast": "0.1.0",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "undici": "8.10.0",
    "uuid": "14.0.2",
    "ws": "8.21.3",
    "xstate": "5.32.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "playwright-bdd": "9.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "esbuild": "0.28.2"
  }
}
