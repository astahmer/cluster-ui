{
  "name": "cluster-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/src/main.ts",
    "seed": "tsx server/src/seed.ts",
    "typecheck": "bash -c 'out=$(tsc --noEmit --pretty false 2>&1); filtered=$(echo \"$out\" | grep -E \"^(server|web|vite\\\\.config|index\\\\.html)\"); if [ -n \"$filtered\" ]; then echo \"$filtered\"; exit 1; fi'",
    "e2e": "tsx server/scripts/e2e.ts",
    "smoke": "node web/smoke.mjs"
  },
