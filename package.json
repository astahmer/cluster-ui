{
  "name": "cluster-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch --experimental-transform-types --no-warnings --import ./scripts/register-ts-resolve.mjs server/src/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --experimental-transform-types --no-warnings --import ./scripts/register-ts-resolve.mjs server/src/main.ts",
    "seed": "node --experimental-transform-types --no-warnings --import ./scripts/register-ts-resolve.mjs server/src/seed.ts",
    "typecheck": "bash -c 'out=$(tsc --noEmit --pretty false 2>&1); filtered=$(echo \"$out\" | grep -E \"^(server|web|vite\\\\.config|index\\\\.html)\"); if [ -n \"$filtered\" ]; then echo \"$filtered\"; exit 1; fi'",
    "e2e": "node --experimental-transform-types --no-warnings --import ./scripts/register-ts-resolve.mjs server/scripts/e2e.ts",
    "smoke": "node web/smoke.mjs",
    "demo-runner": "node --experimental-transform-types --no-warnings --import ./scripts/register-ts-resolve.mjs server/scripts/demo-runner.ts",
    "dev:redis": "bash scripts/dev-redis.sh",
    "seed:redis": "node scripts/demo-redis.mjs",
    "redis:cli": "redis-cli -p 6399"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.41",
    "@ai-sdk/openai": "4.0.46",
    "@ai-sdk/react": "4.0.80",
    "@base-ui/react": "1.7.0",
    "@effect/platform": "link:../effect/packages/platform",
    "@effect/platform-node": "link:../effect/packages/platform-node",
    "@effect/platform-node-shared": "link:../effect/packages/platform-node-shared",
    "@effect/sql": "link:../effect/packages/sql",
    "@effect/sql-sqlite-node": "link:../effect/packages/sql-sqlite-node",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@parcel/watcher": "2.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@xyflow/react": "12.11.3",
    "ai": "7.0.77",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cnfast": "0.1.0",
    "effect": "link:../effect/packages/effect",
    "find-my-way-ts": "0.1.6",
    "ioredis": "6.0.0",
    "mime": "4.1.0",
    "msgpackr": "2.0.5",
    "multipasta": "0.2.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "undici": "8.10.0",
    "uuid": "14.0.2",
    "ws": "8.21.3",
    "xstate": "5.32.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
