    "@effect/sql": "link:../effect/packages/sql",
    "@effect/sql-sqlite-node": "link:../effect/packages/sql-sqlite-node",
    "@opentelemetry/semantic-conventions": "^1.33.0",
    "@parcel/watcher": "^2.5.1",
    "@phosphor-icons/react": "^2.1.10",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.0.8",
    "effect": "link:../effect/packages/effect",
    "find-my-way-ts": "^0.1.5",
    "kumo-ui": "^0.2.1",
    "mime": "^3.0.0",
    "msgpackr": "^1.11.4",
