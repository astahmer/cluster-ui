# cluster-ui server environment — copy to .env to activate.
# dev:server loads this file automatically (--env-file-if-exists=.env).

# Cluster registry: comma-separated "name=spec" entries.
#   sqlite spec: path[:prefix]        (prefix optional, defaults from CLUSTER_UI_PREFIX)
#   redis  spec: redis://host:port    (BullMQ queues; see README "Local redis demo")
#
# Single default cluster (sqlite):
# CLUSTER_UI_CLUSTERS=default=./data/cluster.db
#
# Default cluster + local demo redis (pnpm dev:redis && pnpm seed:redis):
CLUSTER_UI_CLUSTERS=default=./data/cluster.db,local-redis=redis://127.0.0.1:6399

# Server bind
# PORT=8787
# HOST=0.0.0.0

# Write protection: "1" makes all mutating actions return 403
# CLUSTER_UI_READONLY=1

# Token auth for /api/* (sent via Authorization: Bearer or cookie)
# CLUSTER_UI_TOKEN=devtoken

# Deep-link template for an external tracing UI ({traceId} is replaced)
# CLUSTER_UI_TRACE_URL=http://localhost:16686/trace/{traceId}
